{
  "name": "sanghyang-news",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/migrate-production.mjs",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-market-scrapers.ts",
    "health": "curl -f http://localhost:3001/api/health",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test:market": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/test-market-scrapers.ts",
    "test:all": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/test-market-audit-compliance.ts && node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/test-market-outlets-api.ts && node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/test-competitor-social-radar.ts && node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/test-pricing-simulator.ts && node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/test-export-executive-pdf.ts && node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/test-nightly-pipeline.ts",
    "sync:crawlai": "python scripts/export_crawlai_for_ingest.py && node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/ingest-crawlai-evidence.ts",
    "sync:cloud-to-local": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/sync-cloud-to-local.ts"
  },
  "dependencies": {
    "@extractus/article-extractor": "^9.0.1",
    "@google/genai": "^2.18.0",
    "@prisma/client": "^6.19.0",
    "@sparticuz/chromium": "^149.0.0",
    "next": "16.3.2",
    "puppeteer-core": "^25.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "puppeteer": "^25.9.0",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
