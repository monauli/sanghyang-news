generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SourceCategory {
  news
  fnb
  event
  competitor
  review
}

enum ScrapeMethod {
  rss
  http
  browser
  manual
}

enum ArticleStatus {
  discovered
  extracted
  failed
  duplicate
}

enum MarketItemKind {
  fnb
  event
  entertainment
  destination
}

enum ScrapeJob {
  news
}

enum ScrapeRunStatus {
  running
  success
  partial
  failed
}

enum ScrapeStage {
  fetch
  parse
  extract
  persist
}

enum PromotionStatus {
  new
  changed
  expired
}

enum MarketInsightType {
  insight
  opportunity
  recommendation
}

enum MarketInsightStatus {
  active
  archived
}

model Source {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  domain          String
  category        SourceCategory
  method          ScrapeMethod
  enabled         Boolean        @default(true)
  priority        Int            @default(0)
  intervalMinutes Int?
  lastRunAt       DateTime?
  lastSuccessAt   DateTime?
  failureCount    Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  articles        Article[]
  scrapeRuns      ScrapeRun[]
  scrapeErrors    ScrapeError[]

  @@unique([domain, method])
  @@index([category, enabled])
  @@index([enabled, priority])
}

model Article {
  id              String        @id @default(uuid()) @db.Uuid
  sourceId        String        @db.Uuid
  title           String
  canonicalUrl    String?       @unique
  normalizedTitle String
  publishedAt     DateTime?
  description     String?
  content         String?
  imageUrl        String?
  contentHash     String?       @unique
  status          ArticleStatus @default(discovered)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  source          Source        @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  marketItem      MarketItem?

  @@index([sourceId, normalizedTitle, publishedAt])
  @@index([sourceId, contentHash])
  @@index([status, createdAt])
}

model MarketItem {
  id        String         @id @default(uuid()) @db.Uuid
  articleId String         @unique @db.Uuid
  kind      MarketItemKind
  location  String?
  venue     String?
  organizer String?
  brand     String?
  description    String?
  targetAudience String?
  relevanceScore Int?
  startsAt  DateTime?
  endsAt    DateTime?
  tags      Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  article   Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([kind, location])
  @@index([startsAt])
}

model Competitor {
  id             String                    @id @default(uuid()) @db.Uuid
  name           String
  websiteUrl     String?
  googleMapsUrl  String?
  instagramUrl   String?
  facebookUrl    String?
  tiktokUrl      String?
    location       String?
    rating         Decimal?                  @db.Decimal(3, 2)
    reviewCount    Int?
    ratingSource   String?
    ratingSourceUrl String?
    ratingObservedAt DateTime?
    bookingUrl     String?
  socialUrl      String?
  active         Boolean                   @default(true)
  notes          String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  priceSnapshots CompetitorPriceSnapshot[]
  promotions     CompetitorPromotion[]
  reviews        CompetitorReview[]

  @@index([active, name])
}

model CompetitorPriceSnapshot {
  id            String     @id @default(uuid()) @db.Uuid
  competitorId  String     @db.Uuid
  roomName      String?
  packageName   String?
  price         Decimal    @db.Decimal(12, 2)
  originalPrice Decimal?   @db.Decimal(12, 2)
  discount      Decimal?   @db.Decimal(5, 2)
  checkIn       DateTime?
  checkOut      DateTime?
  source        String
  sourceUrl     String?
  observedAt    DateTime   @default(now())
  createdAt     DateTime   @default(now())
  competitor    Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId, observedAt])
  @@index([source, observedAt])
}

model CompetitorPromotion {
  id            String          @id @default(uuid()) @db.Uuid
  competitorId  String          @db.Uuid
  title         String
  category      String
  description   String?
  startsAt      DateTime
  endsAt        DateTime?
  price         Decimal?        @db.Decimal(12, 2)
  originalPrice Decimal?        @db.Decimal(12, 2)
  discount      Decimal?        @db.Decimal(5, 2)
  source        String
  sourceUrl     String?
  imageUrl      String?
  capturedAt    DateTime
  status        PromotionStatus
  createdAt     DateTime        @default(now())
  competitor    Competitor      @relation(fields: [competitorId], references: [id], onDelete: Restrict)

  @@index([competitorId, capturedAt])
  @@index([status, startsAt, endsAt])
}

enum ReviewSentiment {
  positive
  neutral
  negative
}

model CompetitorReview {
  id           String          @id @default(uuid()) @db.Uuid
  competitorId String          @db.Uuid
  externalId   String
  source       String
  sourceUrl    String
  rating       Decimal         @db.Decimal(3, 2)
  reviewDate   DateTime
  title        String?
  text         String
  sentiment    ReviewSentiment
  themes       String[]
  capturedAt   DateTime
  createdAt    DateTime        @default(now())
  competitor   Competitor      @relation(fields: [competitorId], references: [id], onDelete: Restrict)

  @@unique([competitorId, source, externalId])
  @@index([competitorId, reviewDate])
  @@index([sentiment, reviewDate])
}

model MarketInsight {
  id               String              @id @default(uuid()) @db.Uuid
  fingerprint      String
  activeFingerprint String?
  type             MarketInsightType
  title            String
  summary          String
  evidence         Json
  sourceReferences Json
  priority         Int
  confidence       Int
  status           MarketInsightStatus @default(active)
  generatedAt      DateTime            @default(now())
  createdAt        DateTime            @default(now())

  @@index([type, generatedAt])
  @@index([status, generatedAt])
  @@index([fingerprint, status])
}

model ScrapeRun {
  id                String          @id @default(uuid()) @db.Uuid
  sourceId          String          @db.Uuid
  job               ScrapeJob
  status            ScrapeRunStatus @default(running)
  startedAt         DateTime        @default(now())
  finishedAt        DateTime?
  recordsDiscovered Int             @default(0)
  recordsSaved      Int             @default(0)
  duplicates        Int             @default(0)
  errors            Int             @default(0)
  createdAt         DateTime        @default(now())
  source            Source          @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  scrapeErrors      ScrapeError[]

  @@index([sourceId, createdAt])
  @@index([status, createdAt])
}

model ScrapeError {
  id         String      @id @default(uuid()) @db.Uuid
  runId      String      @db.Uuid
  sourceId   String      @db.Uuid
  url        String?
  stage      ScrapeStage
  message    String
  statusCode Int?
  createdAt  DateTime    @default(now())
  run        ScrapeRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  source     Source      @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([runId, createdAt])
  @@index([sourceId, createdAt])
}

model ScrapeLock {
  job        ScrapeJob @id
  acquiredAt DateTime  @default(now())
  ownerToken String
}
